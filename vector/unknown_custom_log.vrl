sanitized_msg = replace(raw_msg, r'\b\d{4}[ -]?\d{4}[ -]?\d{4}\b', "[REDACTED_AADHAAR]")

# Schema Projections into OCSF Standard
.normalized_data.metadata.version = "1.1.0"
